<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="N2N_Saenai.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:N2N_Saenai">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
            <Color x:Key="AppBackgroundColor">#F7F8FC</Color><Color x:Key="AppAccentColor">#4F46E5</Color>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/><SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}"/>
            <Style TargetType="Button"><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="18,10"/></Style>
            <Style TargetType="TextBox"><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12,10"/></Style>
            <Style TargetType="PasswordBox"><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12,10"/></Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
