<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="N2N_Saenai.Views.LoginPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource AppBackgroundBrush}">
  <Grid Padding="52"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Spacing="18" Margin="24"><Border Width="58" Height="58" Background="{StaticResource AppAccentBrush}" CornerRadius="18"><FontIcon Glyph="&#xE968;" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Saenai Network" FontSize="42" FontWeight="SemiBold"/><TextBlock Text="简洁、安全的虚拟网络连接。" FontSize="18" Opacity="0.65"/><TextBlock Text="登录后，应用会校验 TAP 网卡，并由受控的 n2n 会话建立连接。所有连接事件都会留在日志中。" TextWrapping="Wrap" Width="390" Opacity="0.55" Margin="0,22,0,0"/></StackPanel>
    <Border Grid.Column="1" Width="400" Padding="38" CornerRadius="24" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Spacing="16"><TextBlock Text="登录" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="使用你的帐号继续" Opacity="0.6" Margin="0,0,0,10"/><TextBox x:Name="ServerUrl" PlaceholderText="https://your-server/login" Header="服务器地址" KeyDown="ServerUrl_KeyDown"/><TextBox x:Name="Username" PlaceholderText="用户名"/><PasswordBox x:Name="Password" PlaceholderText="密码" KeyDown="Password_KeyDown"/><TextBlock x:Name="HintText" Foreground="#B42318" TextWrapping="Wrap" Visibility="Collapsed"/><Button x:Name="LoginButton" Content="继续" HorizontalAlignment="Stretch" Click="LoginButton_Click" Background="{StaticResource AppAccentBrush}" Foreground="White" Margin="0,8,0,0"/></StackPanel></Border>
  </Grid>
</Page>
