<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="N2N_Saenai.Views.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:N2N_Saenai.Views" Background="{StaticResource AppBackgroundBrush}">
 <Grid Padding="40" RowSpacing="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid><StackPanel Spacing="4"><TextBlock Text="你的网络" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="管理当前虚拟网络连接和运行日志" Opacity="0.6"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="DriverButton" Content="检查 TAP 驱动" Click="DriverButton_Click"/><Button x:Name="LogoutButton" Content="退出登录" Click="LogoutButton_Click"/></StackPanel></Grid>
  <Border Grid.Row="1" Background="White" CornerRadius="20" Padding="26"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><StackPanel Spacing="9"><StackPanel Orientation="Horizontal" Spacing="9"><Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#94A3B8" VerticalAlignment="Center"/><TextBlock x:Name="StatusText" Text="未连接" FontSize="20" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="CommunityText" Opacity="0.7"/><TextBlock x:Name="EndpointText" Opacity="0.7"/><TextBlock x:Name="IpText" Opacity="0.7" Visibility="Collapsed"/></StackPanel><Button Grid.Column="1" x:Name="ConnectButton" Content="连接网络" Background="{StaticResource AppAccentBrush}" Foreground="White" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="48" Click="ConnectButton_Click"/></Grid></Border>
  <Border Grid.Row="2" Background="White" CornerRadius="20" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="活动日志" FontSize="18" FontWeight="SemiBold"/><Button Content="清除" HorizontalAlignment="Right" Click="ClearLog_Click"/></Grid><ListView Grid.Row="1" Margin="0,14,0,0" ItemsSource="{x:Bind LogItems}" IsItemClickEnabled="False" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="local:LogItem"><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Time}" Opacity="0.5"/><TextBlock Grid.Column="1" Text="{x:Bind Source}" Foreground="#4F46E5"/><TextBlock Grid.Column="2" Text="{x:Bind Message}" TextWrapping="Wrap"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
 </Grid>
</Page>
